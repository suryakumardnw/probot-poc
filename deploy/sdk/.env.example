# Dedicated SDK worker model credentials (Phase 2b, NON-PRODUCTION).
#
# Copy to deploy/sdk/.env and fill in. deploy/sdk/.env is gitignored by the
# root `.env` rule and excluded from the Docker build context by
# deploy/sdk/.dockerignore. It is read ONLY by the sdk-worker service.
#
# This file must contain ONLY these three keys. Never add GitHub App
# credentials, tokens, database URLs, Redis URLs, webhook secrets or private
# keys here: the worker is not allowed to have them.
#
# The provider is the existing OpenAI-compatible GLM endpoint. `MODEL_NAME` is
# the "provider/model" form used by the runtime configuration.

# Base URL of the OpenAI-compatible endpoint, e.g. https://llm.nativewit.app/compat
MODEL_BASE_URL=

# Model identifier, e.g. workers-ai/@cf/zai-org/glm-4.7-flash
MODEL_NAME=

# API key/token for the model provider. Never commit this file.
MODEL_API_KEY=

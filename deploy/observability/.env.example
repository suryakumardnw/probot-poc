# Phoenix UI/OTLP host port. Published on 127.0.0.1 only; the container always
# listens on 6006.
PHOENIX_HOST_PORT=6006

# Public endpoint behind Dokploy/Traefik. The Dokploy domain must use Path
# /phoenix with "Strip Path" enabled. For direct loopback access without a
# proxy, blank PHOENIX_HOST_ROOT_PATH and set PHOENIX_ROOT_URL=http://localhost:6006.
PHOENIX_ROOT_URL=https://probot.nativewit.app/phoenix
PHOENIX_HOST_ROOT_PATH=/phoenix

# Traces older than this are deleted automatically. 0 would keep them forever.
PHOENIX_RETENTION_DAYS=30

# Must match deploy/docker-compose.yml. The app compose owns the network.
OBSERVABILITY_NETWORK=ai-pr-reviewer_observability

# Keep auth off for the loopback/SSH-tunnel setup. Set true before adding a
# public Dokploy domain, and fill both secrets (never commit this file).
PHOENIX_ENABLE_AUTH=false
# openssl rand -hex 32
PHOENIX_SECRET=
# Strong first-login password; change it in the UI afterwards.
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=

# If PHOENIX_ENABLE_AUTH=true, also put this in deploy/.env so the worker can
# ingest traces (create a system API key in Phoenix Settings → API Keys):
# OPENCODE_OTLP_HEADERS=authorization=Bearer <phoenix-system-api-key>

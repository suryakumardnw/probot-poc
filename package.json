{
  "name": "probot-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Probot POC app",
  "author": "Surya <surya@example.com>",
  "license": "ISC",
  "homepage": "https://github.com/surya/probot-poc",
  "keywords": [
    "probot",
    "github",
    "probot-app"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "probot run ./lib/index.js",
    "start:probot": "node lib/server.js",
    "start:worker": "node lib/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:characterization": "vitest run --project characterization",
    "security:audit": "node scripts/security-audit.mjs",
    "metrics:quality": "node scripts/quality-metrics.mjs",
    "config:validate": "node lib/scripts/config-validate.js",
    "eval:run": "node lib/scripts/eval-run.js",
    "config:dry-run": "node lib/scripts/config-dry-run.js",
    "model:smoke": "node lib/scripts/model-smoke.js",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@opencode/sdk": "2.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.81.5",
    "dotenv": "^18.0.9",
    "effect": "4.1.0",
    "ejs": "^7.0.2",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "probot": "^14.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.3",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.14.0",
    "nock": "^14.0.5",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "prisma": "^6.19.3",
    "smee-client": "^5.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@types/pg": "8.15.1"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}

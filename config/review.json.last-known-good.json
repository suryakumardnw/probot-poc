{
  "schemaVersion": 1,
  "application": {
    "name": "ai-pr-reviewer",
    "environment": "development",
    "timezone": "UTC"
  },
  "github": {
    "organization": "YOUR_ORGANIZATION",
    "installationScope": "organization",
    "events": [
      "opened",
      "synchronize",
      "ready_for_review",
      "issue_comment"
    ],
    "manualCommand": "/review",
    "defaultReviewType": "standard",
    "draftPullRequests": {
      "enabled": false
    },
    "permissions": {
      "readContents": true,
      "readPullRequests": true,
      "readChecks": true,
      "writePullRequests": true,
      "writeReviewComments": true
    }
  },
  "review": {
    "enabled": true,
    "triggers": {
      "automatic": true,
      "manual": true
    },
    "strategy": {
      "mode": "adaptive",
      "maxStages": 4,
      "verifyFindings": true
    },
    "categories": {
      "functional": true,
      "regression": true,
      "security": true,
      "performance": true,
      "concurrency": true,
      "dataIntegrity": true,
      "errorHandling": true,
      "apiCompatibility": true,
      "maintainability": true,
      "testing": true
    },
    "types": {
      "standard": {
        "enabled": true,
        "publish": true
      },
      "skill": {
        "enabled": false,
        "publish": false
      },
      "handbook": {
        "enabled": true,
        "publish": true,
        "repository": "",
        "branch": "main",
        "path": "",
        "maxChars": 20000
      }
    },
    "severity": [
      "critical",
      "high",
      "medium",
      "low",
      "informational"
    ],
    "confidence": {
      "minimumInline": 0.85,
      "minimumVerified": 0.8
    },
    "findings": {
      "deduplication": true,
      "trackAcrossCommits": true,
      "lifecycleManagement": true,
      "publishUncertainInSummary": true
    },
    "reporting": {
      "summary": true,
      "inlineComments": true,
      "publishCleanReview": true,
      "publishApproval": false
    },
    "conventions": {
      "detectAutomatically": true,
      "customInstructions": ""
    },
    "complexity": {
      "weights": {
        "diffSize": 1,
        "changedFiles": 1,
        "structural": 1.5,
        "dependencyImpact": 1,
        "riskyCode": 2,
        "concurrency": 1.5,
        "dataIntegrity": 2
      },
      "thresholds": {
        "low": 1.5,
        "medium": 3.5
      }
    }
  },
  "agent": {
    "runtime": {
      "type": "opencode-cli",
      "sessionStrategy": "per-review",
      "timeoutMs": 900000
    },
    "context": {
      "adaptive": true,
      "maxFiles": 100,
      "maxRetrievalCalls": 40,
      "maxInputTokens": 60000,
      "maxOutputTokens": 8192
    },
    "tools": {
      "enabled": [
        "read_file",
        "search_code",
        "list_files",
        "inspect_symbols",
        "get_diff"
      ],
      "permissionPolicy": "allowlist"
    }
  },
  "provider": {
    "type": "openai-compatible",
    "baseURL": "${MODEL_BASE_URL}",
    "apiKeyEnv": "MODEL_API_KEY",
    "model": "${MODEL_NAME}",
    "temperature": 0.1,
    "maxOutputTokens": 8192,
    "timeoutMs": 120000,
    "failurePolicy": "fail-immediately"
  },
  "execution": {
    "mode": "static-analysis",
    "commands": {
      "allowlist": [
        "git",
        "grep",
        "find"
      ],
      "allowTests": false,
      "allowBuilds": false,
      "allowPackageScripts": false
    },
    "sandbox": {
      "enabled": false,
      "networkMode": "allowlist",
      "allowedDomains": [],
      "runAsNonRoot": true
    },
    "resources": {
      "cpuLimit": "2",
      "memoryLimit": "2Gi",
      "diskLimit": "5Gi",
      "executionTimeoutMs": 900000
    }
  },
  "repository": {
    "clone": {
      "strategy": "shallow",
      "depth": 1
    },
    "workspace": {
      "retentionHours": 0,
      "cleanupAfterReview": true
    },
    "files": {
      "maxFileBytes": 1000000,
      "maxFilesPerReview": 2000
    }
  },
  "knowledge": {
    "cacheDir": "",
    "fetchTimeoutMs": 30000,
    "skill": {
      "repo": "vercel-labs/open-agents",
      "ref": "cf865e94de7729751c747171785b6ce57e7b178c",
      "skillDir": ".agents/skills/code-review",
      "maxBytes": 200000,
      "maxTokens": 1500
    },
    "handbook": {
      "repo": "nativewit/engineering-handbook",
      "ref": "main",
      "path": "",
      "maxBytes": 2000000,
      "maxTokens": 3000,
      "maxChars": 20000
    }
  },
  "queue": {
    "concurrency": 1,
    "newCommitPolicy": "supersede",
    "retry": {
      "infrastructure": {
        "enabled": true,
        "maxAttempts": 3,
        "backoff": "exponential"
      },
      "providerUnavailable": {
        "enabled": false
      }
    }
  },
  "persistence": {
    "reviewHistoryRetentionDays": 365,
    "findingRetentionDays": 365,
    "auditRetentionDays": 365,
    "artifactRetentionDays": 30
  },
  "configuration": {
    "reloadStrategy": "manual",
    "repositoryOverrides": {
      "enabled": true,
      "allowedSections": [
        "review.categories",
        "review.severity",
        "review.reporting",
        "review.strategy"
      ]
    },
    "validation": {
      "strict": true,
      "dryRun": true
    },
    "rollbackEnabled": true
  },
  "observability": {
    "logs": {
      "level": "info",
      "format": "json"
    },
    "metrics": {
      "enabled": true
    },
    "tracing": {
      "enabled": true
    },
    "langfuse": {
      "enabled": true,
      "plugin": "@langfuse/opencode-observability-plugin@0.7.0"
    },
    "alerts": {
      "reviewFailure": true,
      "queueBacklog": true,
      "providerUnavailable": true,
      "resourceLimitExceeded": true
    }
  },
  "evaluation": {
    "enabled": true,
    "benchmarkSuite": "default",
    "trackFalsePositives": true,
    "trackPrecision": true,
    "trackReviewLatency": true,
    "minimumQualityThreshold": 0.85
  }
}
